# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Replace with your local URI or MongoDB Atlas connection string)
# Local: mongodb://127.0.0.1:27017/btech_puppybala
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/btech_puppybala?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/btech_puppybala

# JWT Secret for Future Admin Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# WhatsApp Business Cloud API (Official Meta Graph API)
# Get credentials from Meta for Developers (developers.facebook.com) -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here
WHATSAPP_API_VERSION=v19.0
WHATSAPP_ENABLED=false
WHATSAPP_MOCK_MODE=true

# Official Public Contact Info (Official WhatsApp number)
VITE_WHATSAPP_NUMBER=919926947052
VITE_WHATSAPP_DISPLAY=+91 9926947052
